    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Axso-148174c2-7a62-422c-8d02-0479938daccd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
