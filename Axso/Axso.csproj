		<HintPath>lib\PowerService.dll</HintPath>
	</Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Application\Configuration\" />
    <Folder Include="Application\Services\" />
    <Folder Include="Domain\Interfaces\" />
    <Folder Include="Infrastructure\Data\" />
